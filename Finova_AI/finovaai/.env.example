POSTGRES_DB=finovaai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Phone push reminders (all optional) ---
# VAPID keys are auto-generated into .vapid_keys.json on first run.
# To use your own: python manage.py generate_vapid_keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_ADMIN_EMAIL=mailto:you@example.com
# REMINDER_TIME_ZONE=Asia/Kolkata
# REMINDER_HOUR=9
# REMINDER_SCHEDULER=1

# --- Deployment (set these as environment variables on your host) ---
# DJANGO_DEBUG=0
# DJANGO_SECRET_KEY=<long random string>
# DJANGO_ALLOWED_HOSTS=yourapp.onrender.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://yourapp.onrender.com
# DJANGO_CORS_ORIGINS=https://yourapp.onrender.com
